{
  "name": "guttore-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "npm run build:web",
    "build:web": "expo export --platform web --output-dir dist && node scripts/prepare-pwa-export.mjs",
    "build:web:hosted": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-web-hosted.ps1 dist",
    "build:web:wife": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-web-profile.ps1 wife dist-wife",
    "typecheck": "tsc --noEmit",
    "fix-deps": "expo install --fix",
    "generate-brand-assets": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-brand-assets.ps1",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:production": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "latest",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-url-polyfill": "latest",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.10",
    "eas-cli": "^21.0.1",
    "typescript": "latest"
  }
}
