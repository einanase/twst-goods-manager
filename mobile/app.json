{
  "expo": {
    "name": "グッとれ",
    "slug": "guttore",
    "scheme": "guttore",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/app/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FFFD"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/app/icon.png",
      "bundleIdentifier": "jp.guttore.app",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": [
          "ja"
        ]
      }
    },
    "android": {
      "package": "jp.guttore.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/adaptive-icon.png",
        "backgroundColor": "#F8FFFD"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/app/icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "在庫画像や取引画像を追加するために写真へのアクセスを使用します。",
          "cameraPermission": "在庫画像や取引画像を撮影するためにカメラを使用します。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "在庫画像や取引画像を撮影するためにカメラを使用します。",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a522c43f-55d3-49da-aac2-ec891b74ce02"
      }
    },
    "owner": "einanase"
  }
}
