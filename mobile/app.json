{
  "expo": {
    "name": "グッズ交換管理",
    "slug": "goods-trade-manager",
    "scheme": "goodstrade",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.goodstrademanager"
    },
    "android": {
      "package": "com.example.goodstrademanager"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "在庫画像や取引画像を追加するために写真へのアクセスを使用します。",
          "cameraPermission": "在庫画像や取引画像を撮影するためにカメラを使用します。"
        }
      ]
    ]
  }
}
