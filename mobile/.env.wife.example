# Wife/private environment template.
# This connects to the existing Supabase project that contains real private data.
# Copy this to .env.wife, fill real values there, then copy .env.wife to .env.
# Do not commit real Supabase values in this file.

EXPO_PUBLIC_SUPABASE_URL=https://wife-project-id.supabase.co
