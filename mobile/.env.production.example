# Production/review environment template.
# This must point to a separate Supabase project with only test or customer data.
# Never point a public store build at the wife/private Supabase project.
# Copy this to .env.production, fill real values there, then copy .env.production to .env.
# Do not commit real Supabase values in this file.

EXPO_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
